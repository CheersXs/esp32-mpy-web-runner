# OLED 循环测试：72x40 分辨率，循环播放，方便随时观察
import time
from machine import I2C, Pin
import ssd1306

i2c = I2C(0, scl=Pin(6), sda=Pin(5), freq=400000)
oled = ssd1306.SSD1306_I2C(72, 40, i2c, addr=0x3C)

print('oled loop test: 72x40, 10 rounds')

for r in range(10):
    # 1. 全白
    oled.fill(1)
    oled.show()
    time.sleep(0.8)
    # 2. 全黑
    oled.fill(0)
    oled.show()
    time.sleep(0.8)
    # 3. 文字（72x40 下 8x8 字体可显示 9 列 x 5 行）
    oled.fill(0)
    oled.text('72x40 OK', 0, 0)
    oled.text('round %d' % (r + 1), 0, 8)
    oled.text('ABCDEFGH', 0, 16)
    oled.text('12345678', 0, 24)
    oled.text('ESP32-C3', 0, 32)
    oled.show()
    time.sleep(1.5)
    # 4. 边框
    oled.fill(0)
    oled.rect(0, 0, 71, 39, 1)
    oled.text('FRAME', 0, 16)
    oled.show()
    time.sleep(1.0)

print('oled loop test done')